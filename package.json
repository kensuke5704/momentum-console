{
  "name": "momentum-console",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "sync:sec": "node --import tsx scripts/sync-sec-nport.ts",
    "sync:universe": "node --import tsx scripts/build-universe.ts",
    "sync:data": "node --import tsx scripts/sync-data.ts",
    "sync:oos": "node --import tsx scripts/sync-oos.ts",
    "freeze:backtest": "node --import tsx scripts/freeze-backtest.ts",
    "sync:all": "npm run sync:sec && npm run sync:universe && npm run sync:data && npm run sync:oos"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.17.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.6",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
